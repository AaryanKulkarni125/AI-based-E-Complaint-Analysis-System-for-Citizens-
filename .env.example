# AI-Powered Citizen Grievance Redressal System — Environment Variables Example
# Copy this file to .env and provide deployment-specific values.
# NEVER commit the actual .env file or production secrets to source control.

# --- Django Core Configuration ---
DJANGO_SECRET_KEY=your-secure-random-secret-key-here-at-least-50-characters
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Security / Registration Codes for Privileged Roles ---
# Gated codes required to register Officer and System Administrator accounts
OFFICER_REGISTRATION_CODE=OFFICER-DEV-2026
ADMIN_REGISTRATION_CODE=SYSADMIN-DEV-2026

# --- Email / Notification Gateway (REQ-NOT-001..005) ---
# For development, console backend prints emails to standard output:
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production SMTP:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.mailgun.org
# EMAIL_PORT=587
# EMAIL_HOST_USER=postmaster@yourdomain.com
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=no-reply@municipal.gov.in

# --- Production Database (PostgreSQL 14+ / MySQL 8+) ---
# SQLite is used by default in development (db.sqlite3).
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=ecomplaint_db
# DB_USER=ecomplaint_user
# DB_PASSWORD=your-db-password
# DB_HOST=localhost
# DB_PORT=5432
